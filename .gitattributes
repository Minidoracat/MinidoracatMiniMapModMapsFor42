# 伺服器端執行的 shell script 必須 LF（CRLF 會讓 heredoc 資料列尾欄帶 CR、算術直接炸）
*.sh text eol=lf

# PZ Lua/JSON 對行尾敏感，統一 LF（CRLF 會讓翻譯檔被引擎靜默忽略）
*.json text eol=lf
*.lua text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.md text eol=lf
*.yml text eol=lf
mod.info text eol=lf
.gitattributes text eol=lf

# workshop.txt 例外：遊戲上傳會整檔回寫成 CRLF，跟著遊戲格式走以消除假差異（入庫仍 LF）
MOD/*/workshop.txt text eol=crlf

# 補充道路 XML 是生成物（scripts/gen_road_supplements.py 輸出 LF），verify 逐位元組比對、
# verify_mod 也檢查 42/media 不得有 CRLF ⇒ 固定 LF，免得 Windows autocrlf 在 checkout 時改成 CRLF。
MOD/*/Contents/mods/*/42/media/minimap/streets/*.xml text eol=lf
